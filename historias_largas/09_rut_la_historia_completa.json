     "fuerza": 0.4
    }
   ],
   "camara": "acercar"
  },
  {
   "fondo": "noche",
   "texto": "A medianoche Booz despertó sobresaltado. ¿Quién eres? Soy Rut, tu sierva. Extiende tu manto sobre mí, porque tú eres mi redentor.",
   "personajes": [
    {
     "id": "booz",
     "x": 0.6,
     "mira": "izquierda",
     "emocion": "sorprendido"
    },
    {
