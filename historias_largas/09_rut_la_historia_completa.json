     "tipo": "luz",
     "x": 0.5
    }
   ],
   "habla": "booz",
   "camara": "fijo"
  },
  {
   "fondo": "noche",
   "texto": "Pero hay un problema: existe otro pariente más cercano que yo. Él tiene el primer derecho. Mañana resolveré este asunto, te lo prometo.",
