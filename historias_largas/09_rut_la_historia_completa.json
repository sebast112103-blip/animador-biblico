    }
   ],
   "habla": "rut",
   "camara": "acercar_rapido"
  },
  {
   "fondo": "noche",
   "texto": "Booz respondió con ternura: Bendita seas, hija mía. No has buscado a los jóvenes, ni ricos ni pobres. Todo mi pueblo sabe que eres una mujer virtuosa.",
   "personajes": [
    {
     "id": "booz",
     "x": 0.55,
     "mira": "izquierda",
     "accion": "ofrecer",
     "emocion": "feliz"
    },
    {
     "id": "rut",
     "x": 0.38,
     "emocion": "feliz"
    }
